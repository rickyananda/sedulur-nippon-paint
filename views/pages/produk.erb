<style>
.produk-hero { background: linear-gradient(135deg, var(--red-dark), var(--red)); color: white; padding: 3.5rem 1.5rem; text-align: center; }
.produk-hero h1 { font-size: 2.2rem; font-weight: 800; margin-bottom: .5rem; }
.produk-hero p { opacity: .85; }
.produk-filter { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 2rem; }
.produk-filter a {
  padding: .5rem 1.1rem; border-radius: 8px; border: 2px solid var(--gray-200);
  background: white; font-size: .85rem; font-weight: 500; cursor: pointer;
  transition: all .2s; text-decoration: none; color: var(--gray-800);
}
.produk-filter a:hover, .produk-filter a.active { background: var(--red); color: white; border-color: var(--red); }
.produk-full-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
.produk-full-card {
  background: white; border-radius: var(--radius-lg); overflow: hidden;
  box-shadow: var(--shadow-sm); border: 1px solid var(--gray-200); transition: all .3s;
}
.produk-full-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.produk-card-header {
  background: linear-gradient(135deg, var(--red-dark), var(--red));
  padding: 2rem; text-align: center;
}
.produk-card-header .icon { font-size: 3rem; }
.produk-card-body { padding: 1.5rem; }
.produk-card-body h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: .5rem; }
.produk-card-body p { font-size: .85rem; color: var(--gray-600); line-height: 1.6; margin-bottom: 1rem; }
.produk-fitur { list-style: none; margin-bottom: 1rem; }
.produk-fitur li { font-size: .82rem; color: var(--gray-700); padding: .2rem 0; }
.produk-fitur li::before { content: '✓ '; color: var(--red); font-weight: 700; }
.produk-kemasan { font-size: .8rem; color: var(--gray-500); margin-bottom: 1rem; }
@media (max-width: 900px) { .produk-full-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .produk-full-grid { grid-template-columns: 1fr; } }
</style>

<section class="produk-hero">
  <h1>🎨 Katalog Produk</h1>
  <p>Lengkap produk Nippon Paint — original, berkualitas, harga terbaik</p>
</section>

<section class="section" style="background:var(--gray-50);">
  <div class="container">
    <div class="produk-filter">
      <% cats = ['Semua', 'Cat Tembok Eksterior', 'Cat Tembok Interior', 'Waterproofing', 'Cat Kayu', 'Cat Besi', 'Cat Special Effect'] %>
      <% cats.each do |cat| %>
        <% active = (@category.nil? && cat == 'Semua') || @category == cat %>
        <a href="/produk<%= cat == 'Semua' ? '' : '?kategori=' + URI.encode_www_form_component(cat) %>"
           class="<%= active ? 'active' : '' %>"><%= cat %></a>
      <% end %>
    </div>

    <div class="produk-full-grid">
      <% filtered = @category ? @products.select { |p| p['kategori'] == @category } : @products %>
      <% filtered.each do |p| %>
      <div class="produk-full-card fade-in">
        <div class="produk-card-header">
          <div class="icon"><%= p['icon'] %></div>
        </div>
        <div class="produk-card-body">
          <% tier = p['tier'].downcase.gsub(' ','') %>
          <span class="tier-badge tier-<%= tier == 'ultrapremium' ? 'ultra' : tier %>" style="margin-bottom:.5rem;display:inline-block;"><%= p['tier'] %></span>
          <h3><%= p['nama'] %></h3>
          <p><%= p['deskripsi'] %></p>
          <ul class="produk-fitur">
            <% p['fitur'].each do |f| %>
            <li><%= f %></li>
            <% end %>
          </ul>
          <div class="produk-kemasan">📦 Kemasan: <%= p['kemasan'].join(' | ') %></div>
          <a href="https://wa.me/6287843954886?text=Halo%2C%20saya%20ingin%20tanya%20produk%20<%= URI.encode_www_form_component(p['nama']) %>"
             class="btn btn-red" style="width:100%;justify-content:center;" target="_blank">
            💬 Tanya Harga
          </a>
        </div>
      </div>
      <% end %>
    </div>
  </div>
</section>
