<style>
.page-hero { background: linear-gradient(135deg, var(--red-dark), var(--red)); color: white; padding: 3.5rem 1.5rem; text-align: center; }
.page-hero h1 { font-size: 2.2rem; font-weight: 800; margin-bottom: .5rem; }
.page-hero p { opacity: .85; }
.kontak-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; max-width: 1100px; margin: 0 auto; }
.kontak-info-card { background: white; border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-sm); border: 1px solid var(--gray-200); }
.kontak-info-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--red); }
.kontak-item { display: flex; gap: 1rem; margin-bottom: 1.25rem; align-items: flex-start; }
.kontak-item-icon { width: 42px; height: 42px; border-radius: 10px; background: #ffebee; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
.kontak-item-text strong { display: block; font-size: .88rem; font-weight: 600; margin-bottom: .2rem; }
.kontak-item-text span { font-size: .83rem; color: var(--gray-600); line-height: 1.6; }
.kontak-item-text a { color: var(--red); text-decoration: none; font-weight: 500; }
.kontak-item-text a:hover { text-decoration: underline; }
.wa-buttons { display: flex; flex-direction: column; gap: .75rem; margin-top: 1.5rem; }
.wa-btn {
  display: flex; align-items: center; gap: .75rem;
  background: #25d366; color: white; padding: 1rem 1.25rem;
  border-radius: var(--radius); text-decoration: none; font-weight: 600;
  transition: all .2s;
}
.wa-btn:hover { background: #128c7e; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(37,211,102,.3); }
.wa-btn .wa-icon { font-size: 1.5rem; }
.wa-btn-text strong { display: block; font-size: .9rem; }
.wa-btn-text span { font-size: .78rem; opacity: .85; }
.order-form { background: white; border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-sm); border: 1px solid var(--gray-200); }
.order-form h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--red); }
.form-group { margin-bottom: 1.1rem; }
.form-group label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: .4rem; color: var(--gray-800); }
.form-group input, .form-group select, .form-group textarea {
  width: 100%; padding: .7rem 1rem; border: 2px solid var(--gray-200);
  border-radius: 8px; font-size: .9rem; font-family: inherit;
  transition: border-color .2s; outline: none;
}
.form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--red); }
.form-group textarea { resize: vertical; min-height: 80px; }
.jam-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 1100px; margin: 2rem auto 0; }
.jam-card { background: white; border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow-sm); border: 1px solid var(--gray-200); text-align: center; }
.jam-card h4 { font-size: .95rem; font-weight: 700; margin-bottom: .5rem; }
.jam-card p { font-size: .85rem; color: var(--gray-600); }
.jam-card .jam { font-size: 1.1rem; font-weight: 700; color: var(--red); margin-top: .25rem; }
@media (max-width: 768px) {
  .kontak-grid { grid-template-columns: 1fr; }
  .jam-grid { grid-template-columns: 1fr; }
}
</style>

