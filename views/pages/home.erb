<style>
/* HERO */
.hero {
  background: linear-gradient(135deg, var(--red-dark) 0%, var(--red) 50%, #e53935 100%);
  color: white; padding: 6rem 1.5rem 5rem; text-align: center; position: relative; overflow: hidden;
}
.hero::before {
  content: ''; position: absolute; inset: 0;
  background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.hero-content { position: relative; max-width: 700px; margin: 0 auto; }
.hero-badge {
  display: inline-block; background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.3);
  padding: .4rem 1rem; border-radius: 999px; font-size: .8rem; font-weight: 500; margin-bottom: 1.5rem;
}
.hero h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.15; margin-bottom: 1rem; }
.hero h1 span { color: var(--gold); }
.hero p { font-size: 1.1rem; opacity: .9; margin-bottom: 2.5rem; line-height: 1.7; }
.hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
.hero-stats {
  display: flex; gap: 2.5rem; justify-content: center; margin-top: 3.5rem;
  padding-top: 2.5rem; border-top: 1px solid rgba(255,255,255,.2); flex-wrap: wrap;
}
.hero-stat { text-align: center; }
.hero-stat strong { display: block; font-size: 1.8rem; font-weight: 800; color: var(--gold); }
.hero-stat span { font-size: .82rem; opacity: .8; }

/* KEUNGGULAN */
.keunggulan { background: var(--gray-50); }
.keunggulan-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
  max-width: 1100px; margin: 0 auto;
}
.keunggulan-card {
  background: white; border-radius: var(--radius); padding: 2rem 1.5rem;
  box-shadow: var(--shadow-sm); border: 1px solid var(--gray-200);
  transition: all .3s;
}
.keunggulan-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--red-light); }
.keunggulan-icon {
  width: 52px; height: 52px; border-radius: 12px;
  background: linear-gradient(135deg, var(--red), var(--red-light));
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem; margin-bottom: 1rem;
}
.keunggulan-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: .5rem; }
.keunggulan-card p { font-size: .85rem; color: var(--gray-600); line-height: 1.6; }

/* PRODUK UNGGULAN */
.produk-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem;
  max-width: 1100px; margin: 0 auto;
}
.produk-card {
  background: white; border-radius: var(--radius); padding: 1.5rem;
  box-shadow: var(--shadow-sm); border: 1px solid var(--gray-200);
  transition: all .3s; cursor: pointer;
}
.produk-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.produk-icon { font-size: 2.5rem; margin-bottom: 1rem; }
.produk-card h3 { font-size: .95rem; font-weight: 700; margin-bottom: .4rem; }
.produk-card p { font-size: .8rem; color: var(--gray-600); line-height: 1.5; margin-bottom: .75rem; }
.produk-card .kemasan { font-size: .75rem; color: var(--gray-400); }

/* PROMO BANNER */
.promo-banner {
  background: linear-gradient(135deg, #f57f17, var(--gold), #ffca28);
  padding: 3.5rem 1.5rem; text-align: center;
}
.promo-banner h2 { font-size: 2rem; font-weight: 800; color: var(--gray-900); margin-bottom: .75rem; }
.promo-banner p { font-size: 1rem; color: var(--gray-800); margin-bottom: 2rem; }

/* HARGA PREVIEW */
.harga-preview { background: white; }
.harga-table-wrap { max-width: 1100px; margin: 0 auto; overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: .88rem; }
thead tr { background: var(--red); color: white; }
thead th { padding: .85rem 1rem; text-align: left; font-weight: 600; }
tbody tr { border-bottom: 1px solid var(--gray-200); transition: background .15s; }
tbody tr:hover { background: var(--gray-50); }
tbody td { padding: .75rem 1rem; }
.tier-badge { font-size: .7rem; font-weight: 600; padding: .2rem .6rem; border-radius: 999px; }
.tier-ultra { background: #fff3e0; color: #e65100; }
.tier-premium { background: #e8f5e9; color: #2e7d32; }
.tier-standar { background: #e3f2fd; color: #1565c0; }
.tier-ekonomis { background: #f3e5f5; color: #6a1b9a; }

/* KONTAK STRIP */
.kontak-strip {
  background: var(--red); color: white; padding: 3rem 1.5rem; text-align: center;
}
.kontak-strip h2 { font-size: 1.8rem; font-weight: 700; margin-bottom: .5rem; }
.kontak-strip p { opacity: .9; margin-bottom: 2rem; }
.kontak-strip-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

@media (max-width: 900px) {
  .keunggulan-grid { grid-template-columns: repeat(2, 1fr); }
  .produk-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .keunggulan-grid { grid-template-columns: 1fr; }
  .produk-grid { grid-template-columns: repeat(2, 1fr); }
  .hero-stats { gap: 1.5rem; }
}
</style>

<!-- HERO -->
